  "guide": {
    "phases": {
      "preparation": {
        "mealsSummary": "Lait uniquement",
        "items": [
          {
            "text": "L'OMS recommande le lait seul jusqu'à 6 mois, puis des aliments en complément du lait.",
            "sources": [
              "oms"
            ]
          },
          {
            "text": "En France, la diversification peut commencer entre 4 et 6 mois révolus, jamais avant 4 mois.",
            "sources": [
              "anses",
              "spf"
            ]
          },
          {
            "text": "Prématuré : demander l'avis du pédiatre pour le bon moment.",
            "sources": [
              "spf"
            ]
          }
        ]
      },
      "months6To8": {
        "mealsSummary": "2 à 3 repas",
        "items": [
          {
            "text": "2 à 3 repas par jour en plus du lait, et 1 à 2 collations selon l'appétit.",
            "sources": [
              "oms"
            ]
          },
          {
            "text": "Textures : bouillie épaisse, aliments bien écrasés, puis plats familiaux écrasés.",
            "sources": [
              "oms"
            ]
          },
          {
            "text": "Commencer par 2 à 3 cuillères, jusqu'à un demi-bol de 250 ml.",
            "sources": [
              "oms"
            ]
          },
          {
            "text": "Vers 8 mois : aliments hachés ou écrasés grossièrement, morceaux très fondants.",
            "sources": [
              "spf"
            ]
          },
          {
            "text": "Au moins 500 ml de lait maternel ou infantile par jour jusqu'à 1 an.",
            "sources": [
              "anses"
            ]
          },
          {
            "text": "Viande, poisson ou œuf : environ 10 g par jour.",
            "sources": [
              "anses"
            ]
          },
          {
            "text": "Ajouter une cuillère à café d'huile (colza, noix, olive en alternance) ou une noisette de beurre.",
            "sources": [
              "anses",
              "spf"
            ]
          }
        ]
      },
      "months9To11": {
        "mealsSummary": "3 à 4 repas",
        "items": [
          {
            "text": "3 à 4 repas par jour et 1 à 2 collations.",
            "sources": [
              "oms"
            ]
          },
          {
            "text": "Textures : haché fin, écrasé, aliments à prendre avec les doigts.",
            "sources": [
              "oms"
            ]
          },
          {
            "text": "Un demi-bol de 250 ml par repas.",
            "sources": [
              "oms"
            ]
          },
          {
            "text": "Des morceaux à croquer et à mâcher dès 10 mois ; ne pas dépasser 10 mois pour les textures non lisses.",
            "sources": [
              "spf",
              "anses"
            ]
          }
        ]
      },
      "months12To23": {
        "mealsSummary": "3 à 4 repas",
        "items": [
          {
            "text": "3 à 4 repas par jour et 1 à 2 collations.",
            "sources": [
              "oms"
            ]
          },
          {
            "text": "Plats familiaux, hachés ou écrasés si besoin.",
            "sources": [
              "oms"
            ]
          },
          {
            "text": "Trois quarts à un bol de 250 ml par repas.",
            "sources": [
              "oms"
            ]
          },
          {
            "text": "Dès 1 an : 3 repas et un goûter.",
            "sources": [
              "spf"
            ]
          },
          {
            "text": "Viande, poisson ou œuf : environ 20 g par jour.",
            "sources": [
              "anses"
            ]
          },
          {
            "text": "Lait : environ 500 ml par jour, pas plus de 800 ml.",
            "sources": [
              "spf",
              "anses"
            ]
          }
        ]
      }
    },
    "readinessSigns": [
      {
        "text": "Tient sa tête et son dos bien droits.",
        "sources": [
          "spf"
        ]
      },
      {
        "text": "Avale bien les purées lisses.",
        "sources": [
          "spf"
        ]
      },
      {
        "text": "Attrape les aliments et les porte à sa bouche.",
        "sources": [
          "spf"
        ]
      },
      {
        "text": "Fait des mouvements de mâchonnement.",
        "sources": [
          "spf"
        ]
      }
    ],
    "hungerSigns": [
      {
        "text": "Pleure ou s'agite.",
        "sources": [
          "spf"
        ]
      },
      {
        "text": "Ouvre la bouche à l'approche de la cuillère.",
        "sources": [
          "spf"
        ]
      }
    ],
    "satietySigns": [
      {
        "text": "Ralentit, tourne la tête, regarde ailleurs.",
        "sources": [
          "spf"
        ]
      },
      {
        "text": "Ferme la bouche ou repousse la cuillère.",
        "sources": [
          "spf"
        ]
      }
    ],
    "safety": [
      {
        "text": "Proposer sans jamais forcer, ne pas obliger à finir.",
        "sources": [
          "oms",
          "spf"
        ]
      },
      {
        "text": "Toujours assis et surveillé pendant tout le repas.",
        "sources": [
          "spf"
        ]
      },
      {
        "text": "Pas d'écran pendant le repas, pas d'aliment en récompense.",
        "sources": [
          "spf"
        ]
      },
      {
        "text": "Aliments petits, durs et ronds (fruits à coque entiers, cacahuètes) : jamais avant 5 ans.",
        "sources": [
          "spf"
        ]
      },
      {
        "text": "Couper en deux ou en quatre les aliments ronds et mous (raisin, tomate cerise), retirer pépins et noyaux.",
        "sources": [
          "spf"
        ]
      },
      {
        "text": "Présenter un nouvel aliment seul, pour qu'elle en découvre le goût. Un refus n'est pas une allergie : reproposer jusqu'à 8 à 10 fois.",
        "sources": [
          "spf",
          "anses"
        ]
      },
      {
        "text": "Ne pas retarder l'œuf, l'arachide, le gluten et le lait, même en cas de terrain allergique.",
        "sources": [
          "anses",
          "espghan"
        ]
      }
    ]
  },
